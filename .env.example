# Copy to .env.local to override build-time settings.

# Backend base URL. Leave unset (default `/api`) so requests go through the
# dev server's proxy to http://localhost:8000 (server.proxy in vite.config.ts),
# or through nginx in production. Set it only to reach a backend at another
# origin directly; that backend must list this origin in its
# `[server] cors_origins`.
# VITE_API_BASE_URL=http://localhost:8000

# Intake station's ibp-print-server (default http://localhost:40121).
# VITE_PRINT_SERVER_URL=http://localhost:40121
